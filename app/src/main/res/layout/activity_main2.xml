<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(FT)无UI拆分接口"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:textColor="@color/dotRed"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="10dp"
        android:background="@color/dotRed"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button
                android:id="@+id/init"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="initSDK"
                android:backgroundTint="@color/biometric_error_color"
                android:text="初始化"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/colorPrimary"
                android:onClick="loginUI"
                android:text="游客登录"
                android:textColor="@color/white" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="LoginByNuts"
                android:backgroundTint="@color/colorAccent"
                android:text="坚果账号登录"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="logout"
                android:backgroundTint="@color/colorAccent"
                android:text="退出登录"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="LoginBySocialGoogle"
                android:backgroundTint="@color/colorAccent"
                android:text="google登录"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="LoginBySocialFB"
                android:backgroundTint="@color/colorAccent"
                android:text="FB登录"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="BindBySocialGoogle"
                android:backgroundTint="@color/colorPrimary"
                android:text="绑定谷歌"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="BindBySocialGoogleRetry"
                android:backgroundTint="@color/colorPrimary"
                android:text="绑定谷歌(换号重绑)"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="BindBySocialFacebook"
                android:backgroundTint="@color/colorPrimary"
                android:text="绑定脸书"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="BindBySocialFacebookRetry"
                android:backgroundTint="@color/colorPrimary"
                android:text="绑定脸书(换号重绑)"
                android:visibility="gone"
                android:textColor="@color/white"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="QueryBindStatus"
                android:backgroundTint="@color/colorPrimary"
                android:text="查询绑定状态"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:onClick="clear"
        android:text="清空日志"
        android:textColor="@color/colorAccent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"/>
    </ScrollView>

</LinearLayout>